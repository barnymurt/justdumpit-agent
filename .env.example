# Required: MiniMax API key (same one as justdumpit-ytscraper)
MINIMAX_API_KEY=your_key_here

# Required: URL of the justdumpit-ytscraper deployment
# (this agent calls back to it for goals + Stage 2 payloads)
JUSTDUMPIT_URL=https://justdumpit-ytscraper.fly.dev

# Optional: shared secret that justdumpit sends in webhook Authorization header
# (generate something random and put it in BOTH this .env AND justdumpit's fly secrets)
JUSTDUMPIT_API_TOKEN=

# Required: GitHub PAT (create at https://github.com/settings/tokens)
# Needs `repo` scope to create PRs and issues across your repos.
GH_TOKEN=ghp_replace_me

# Optional: GitHub owner (defaults to barnymurt)
# GH_OWNER=barnymurt

# Where the SQLite audit DB lives on Fly (mounted at /data)
AGENT_DATA_DIR=/data

# Cron fallback: poll justdumpit every N seconds for missed webhook events.
POLLER_INTERVAL=900
POLLER_ENABLED=true
POLLER_STARTUP_DELAY=120